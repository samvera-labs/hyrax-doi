<% doi_value = Array(f.object.doi).first %>
<% minting_enabled = Flipflop.enabled?(:doi_minting) %>
<% supports_status = f.object.respond_to?(:doi_status_when_public) %>
<%# What DataCite reports, not what the depositor asked for. A DOI already past draft
    cannot go back, so those options are closed off. %>
<% current_state = f.object.model.try(:doi_state) %>

<div data-doi-tab
     data-doi-required-fields="<%= doi_required_fields(f.object).to_json %>"
     data-doi-missing-warning="<%= t('hyrax.doi.form.missing_required_confirm') %>">
  <%# Stored multivalued for indexing, but a work has one DOI, so it renders as one field. %>
  <%= f.input :doi,
              input_html: { value: doi_value,
                            name: "#{f.object.model_name.param_key}[doi][]",
                            data: { 'doi-input': true },
                            class: 'form-control',
                            style: 'max-width: 40em' } %>

  <% if minting_enabled && doi_value.blank? %>
    <p>
      <button type="button"
              class="btn btn-secondary"
              data-doi-draft-button
              data-doi-url="<%= Hyrax::DOI::Engine.routes.url_helpers.create_draft_doi_path %>"
              data-doi-working="<%= t('hyrax.doi.form.draft.working') %>"
              data-doi-error="<%= t('hyrax.doi.form.draft.error') %>">
        <%= t('hyrax.doi.form.draft.label') %>
      </button>
      <span class="form-text" data-doi-status aria-live="polite"></span>
    </p>
    <p class="form-text"><%= t('hyrax.doi.form.draft.help') %></p>
  <% end %>

  <%# Offered whether or not a DOI is reserved: the depositor may be describing work that
      was published elsewhere first. %>
  <p>
    <button type="button"
            class="btn btn-secondary"
            data-doi-autofill-button
            data-doi-url="<%= Hyrax::DOI::Engine.routes.url_helpers.autofill_path %>"
            data-doi-confirm="<%= t('hyrax.doi.form.autofill.confirm') %>"
            data-doi-working="<%= t('hyrax.doi.form.autofill.working') %>"
            data-doi-error="<%= t('hyrax.doi.form.autofill.error') %>"
            data-doi-missing="<%= t('hyrax.doi.form.autofill.missing') %>"
            data-doi-empty="<%= t('hyrax.doi.form.autofill.empty') %>"
            data-doi-param-key="<%= f.object.model_name.param_key %>">
      <%= t('hyrax.doi.form.autofill.label') %>
    </button>
    <span class="form-text" data-doi-autofill-status aria-live="polite"></span>
  </p>

  <% if minting_enabled && supports_status %>
    <fieldset class="set-doi-status-when-public">
      <legend class="h5"><%= t('hyrax.doi.form.status.legend') %></legend>
      <p class="form-text"><%= t('hyrax.doi.form.status.help') %></p>

      <%# Blank leads: it is the default, and it means no DOI is minted. %>
      <% ([''] + Hyrax::DOI::DataCiteRegistrar::STATES).each do |state| %>
        <div class="form-check">
          <%= f.radio_button :doi_status_when_public, state,
                             class: 'form-check-input',
                             data: { 'doi-status-radio': true },
                             disabled: Hyrax::DOI::DataCiteRegistrar.state_unreachable?(state, from: current_state),
                             id: "#{f.object.model_name.param_key}_doi_status_when_public_#{state.presence || 'none'}" %>
          <%= f.label :doi_status_when_public,
                      t("hyrax.doi.form.status.options.#{state.presence || 'none'}"),
                      value: state,
                      class: 'form-check-label font-weight-normal',
                      for: "#{f.object.model_name.param_key}_doi_status_when_public_#{state.presence || 'none'}" %>
        </div>
      <% end %>
    </fieldset>
  <% end %>
</div>
